<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fitness & Workout Tracker</title>
    <!-- Bootstrap CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <div class="container-fluid p-4">
        <!-- Main Heading -->
        <h1 class="fw-bold">Fitness & Workout Tracker</h1>
        
        <!-- Subheading -->
        <h2 class="text-secondary">Stay active, stay healthy!</h2>
        
        <!-- Introduction Paragraph -->
        <p class="lead">
            Welcome to your personal fitness dashboard. Track your workouts, monitor your goals, and stay on top of your health.
        </p>

        <!-- Image -->
        <div class="my-3">
            <img src="https://images.unsplash.com/photo-1517838277536-f5f99be501cd?w=800" class="img-fluid rounded" style="max-height: 250px;" alt="Fitness Workout">
        </div>

        <!-- Secondary Heading -->
        <h4 class="mt-4">Log Your Daily Progress</h4>
        
        <!-- Supporting Paragraph -->
        <p>
            Consistency is key. Record your daily training stats to see continuous improvements over time.
        </p>

        <!-- Navigation Tabs -->
        <ul class="nav nav-tabs mt-5" id="fitnessTab">
            <li class="nav-item">
                <a class="nav-link active" href="#">Overview</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">Cardio</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">Strength</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">Flexibility</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">Nutrition</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">Goals</a>
            </li>
        </ul>

        <!-- Card Section -->
        <div class="card mt-0 shadow-sm">
            <!-- Card Header -->
            <div class="card-header bg-danger text-white text-center fw-bold py-3">
                Daily Workout Log
            </div>

            <!-- Card Body -->
            <div class="card-body">
                <form>
                    <!-- Name Field -->
                    <div class="mb-3 row">
                        <label for="username" class="col-sm-2 col-form-label fw-bold">Name</label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control" id="username" placeholder="Enter your name">
                        </div>
                    </div>

                    <!-- Workout Type -->
                    <div class="mb-3 row">
                        <label for="workout" class="col-sm-2 col-form-label fw-bold">Workout</label>
                        <div class="col-sm-10">
                            <select class="form-select" id="workout">
                                <option selected>Cardio (Running / Cycling)</option>
                                <option value="1">Weightlifting / Strength</option>
                                <option value="2">HIIT Training</option>
                                <option value="3">Yoga / Stretching</option>
                            </select>
                        </div>
                    </div>

                    <!-- Duration Field -->
                    <div class="mb-3 row">
                        <label for="duration" class="col-sm-2 col-form-label fw-bold">Duration (Mins)</label>
                        <div class="col-sm-10">
                            <input type="number" class="form-control" id="duration" placeholder="e.g., 45">
                        </div>
                    </div>
                </form>
            </div>

            <!-- Card Footer with Navigation Buttons -->
            <div class="card-footer text-center py-3">
                <button class="btn btn-danger me-2 px-4">Prev</button>
                <button class="btn btn-danger px-4">Save Log</button>
            </div>
        </div>
    </div>

</body>
</html>
